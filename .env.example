# =========================================================
# CONFIGURAÇÃO DE AMBIENTE - QUALITECH SAP PORTAL
# =========================================================
# Copie estas variáveis para o seu arquivo .env ou configure
# no painel do Netlify (Site Settings > Environment Variables)
# =========================================================

# URL do SAP Business One Service Layer
# Exemplo: https://piqualithse.b1cloud.com.br:50000/b1s/v1
SAP_SERVICE_LAYER_URL=https://piqualithse.b1cloud.com.br:50000/b1s/v1

# Banco de dados / Empresa padrão (CompanyDB)
# Exemplo: SBO_QUALITECH_QAS ou SBO_QUALITECH_PROD
SAP_COMPANY_DB=SBO_QUALITECH_QAS

# Usuário de sistema para conexões e integrações
SAP_USER_NAME=B1i

# Senha do usuário de sistema
SAP_PASSWORD=1234

# Porta do servidor (padrão 3000 em ambiente local/container)
PORT=3000

# URL pública da aplicação (injetada automaticamente ou informe a URL do Netlify)
APP_URL=https://seu-portal.netlify.app

# Variáveis opcionais expostas para o frontend (Vite)
VITE_SAP_SERVICE_LAYER_URL=https://piqualithse.b1cloud.com.br:50000/b1s/v1
VITE_DEFAULT_COMPANY_DB=SBO_QUALITECH_QAS
